"""
Suite de tests pour la classe PastilleV1 (cylindre plein).
Lancer avec : pytest test_pastille_v1.py -v

On teste le solveur brut ; la geometrie cylindrique (centre, aires
variables) recoit ses propres tests dedies plus bas.
"""

import numpy as np
import pytest
from pastille_v1 import PastilleV1


def make_pastille(N=51, dt=0.05, alpha=6.9e-7, k_th=3.0, R=4.1e-3,
                   T_surface=320.0, T_init=None, source=None):
    """Constructeur raccourci avec des valeurs par defaut raisonnables
    (ordres de grandeur UO2 / REP)."""
    return PastilleV1(
        alpha=alpha, k_th=k_th, R=R, N=N, dt=dt,
        T_surface=T_surface, T_init=T_init, source=source,
    )


# --- Tests du solveur de base ---

def test_bord_dirichlet():
    """La surface (dernier noeud) reste exactement a T_surface."""
    pas = make_pastille(T_surface=320.0)
    pas.solve(200)
    assert pas.T[-1] == pytest.approx(320.0)


def test_stabilite_bornee():
    """CN est inconditionnellement stable : la solution reste bornee
    meme avec un pas de temps agressif."""
    pas = make_pastille(dt=1.0, source=3.8e8)
    pas.solve(500)
    assert np.all(np.isfinite(pas.T))
    assert pas.T.max() < 5000.0     # marge de securite large
    assert pas.T.min() > -100.0


def test_isotherme_sans_source():
    """Sans source, une pastille initialement a T_surface partout doit
    rester a T_surface partout (equilibre trivial)."""
    N = 41
    pas = make_pastille(N=N, source=None,
                         T_init=np.full(N, 320.0), T_surface=320.0)
    pas.solve(500)
    assert np.allclose(pas.T, 320.0, atol=1e-8)


# --- Tests specifiques a la geometrie cylindrique ---

def test_centre_maximum_temperature():
    """Avec une source positive, le centre (r=0) doit rester le point
    le plus chaud et le profil strictement decroissant vers le bord --
    verifie la symetrie sans l'avoir imposee explicitement."""
    pas = make_pastille(source=3.8e8)
    pas.solve(3000)
    assert pas.T[0] == pas.T.max()
    assert np.all(np.diff(pas.T) <= 1e-9)


def test_parabole_regime_permanent():
    """Avec une source uniforme, le regime permanent doit etre la
    parabole exacte T(r) = T_surf + (dot_q / 4k) (R^2 - r^2). Valide
    le stencil cylindrique dans son ensemble, y compris le traitement
    du centre (facteur 4, pas 2)."""
    N = 101
    R = 4.1e-3
    k_th = 3.0
    T_surf = 320.0
    dot_q = 3.8e8

    pas = make_pastille(N=N, R=R, k_th=k_th, T_surface=T_surf,
                         T_init=np.full(N, T_surf), source=dot_q,
                         dt=0.05)
    pas.solve(6000)     # t = 300 s >> temps caracteristique R^2/alpha ~ 24 s

    T_exact = T_surf + (dot_q / (4 * k_th)) * (R**2 - pas.r**2)
    assert np.max(np.abs(pas.T - T_exact)) < 0.5   # degC


def test_pas_de_singularite_au_centre():
    """Aucun NaN/Inf au noeud central, quelle que soit la resolution --
    un traitement naif en 1/r non regularise aurait echoue ici."""
    for N in [11, 51, 201]:
        pas = make_pastille(N=N, source=3.8e8)
        pas.solve(100)
        assert np.isfinite(pas.T[0])
        assert not np.isnan(pas.aE[0])


def test_bilan_energie_regime_permanent():
    """En regime permanent, la puissance generee dans le disque de
    rayon (R - dr/2) doit egaler la puissance qui traverse la derniere
    face interne -- consequence directe de la conservation exacte des
    volumes finis."""
    N = 101
    R = 4.1e-3
    dot_q = 3.8e8

    pas = make_pastille(N=N, R=R, source=dot_q,
                         T_init=np.full(N, 320.0), dt=0.05)
    pas.solve(6000)

    r_face_last = R - pas.dr / 2
    P_generee = dot_q * np.pi * r_face_last**2
    P_sortante = pas.flux_sortant_frontiere()

    assert P_sortante == pytest.approx(P_generee, rel=1e-3)


def test_source_nulle_equivaut_none():
    N = 51
    T_init = np.full(N, 320.0)

    pas_none = make_pastille(N=N, T_init=T_init.copy(), source=None)
    pas_zero = make_pastille(N=N, T_init=T_init.copy(), source=0.0)
    pas_none.solve(300)
    pas_zero.solve(300)

    assert np.allclose(pas_none.T, pas_zero.T, atol=1e-12)


@pytest.mark.parametrize("N", [21, 51, 101, 201])
def test_stabilite_plusieurs_maillages(N):
    """Solution bornee, Dirichlet tenu et centre fini, quel que soit N."""
    pas = make_pastille(N=N, source=3.8e8)
    pas.solve(1000)
    assert np.all(np.isfinite(pas.T))
    assert pas.T[-1] == pytest.approx(320.0)
    assert pas.T[0] >= pas.T[-1]


def test_convergence_maillage():
    """L'erreur doit decroitre en O(dr^2) quand on raffine le maillage.

    Avec une source UNIFORME la solution exacte est une parabole (degre
    2), or un schema centre d'ordre 2 represente exactement les
    polynomes de degre <=2 (erreur a la precision machine, independante
    de N) -- ce cas ne peut donc pas servir a verifier la convergence
    (voir test_parabole_regime_permanent, qui l'exploite au contraire
    comme validation forte).

    Pour observer une vraie erreur de troncature on utilise une source
    non uniforme dot_q(r) = q0*(r/R)^2, dont la solution stationnaire
    exacte est un polynome de degre 4 :
        T(r) = T_surf + q0/(16 k R^2) * (R^4 - r^4)
    """
    R = 4.1e-3
    k_th = 3.0
    T_surf = 320.0
    q0 = 3.8e8
    erreurs = []
    tailles = [21, 51, 101]

    for N in tailles:
        r = np.linspace(0, R, N)
        source = q0 * (r / R) ** 2
        pas = make_pastille(N=N, R=R, k_th=k_th, T_surface=T_surf,
                             T_init=np.full(N, T_surf), source=source,
                             dt=0.05)
        pas.solve(6000)
        T_exact = T_surf + (q0 / (16 * k_th * R**2)) * (R**4 - pas.r**4)
        erreurs.append(np.max(np.abs(pas.T - T_exact)))

    # L'erreur doit decroitre strictement quand N augmente
    assert erreurs[1] < erreurs[0]
    assert erreurs[2] < erreurs[1]

    # Et decroitre en O(dr^2) : doubler N (donc diviser dr par ~2) doit
    # diviser l'erreur par un facteur proche de 4
    ratio_51_101 = erreurs[1] / erreurs[2]
    assert 3.0 < ratio_51_101 < 5.0
