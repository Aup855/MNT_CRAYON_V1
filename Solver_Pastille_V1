"""
Solveur 1D de conduction thermique dans une pastille combustible
(cylindre plein, monomateriau), volumes finis + Crank-Nicolson.

Hypotheses :
    - geometrie cylindrique 1D radiale, symetrie au centre (aucune CL
      a imposer : elle emerge naturellement de l'aire de face nulle
      en r=0)
    - temperature imposee en surface (Dirichlet)
    - source volumique uniforme ou variable (fission)
    - proprietes materiau (k, alpha) constantes

Discretisation vertex-centered : le noeud i porte la cellule
[r_i-1/2, r_i+1/2]. Crank-Nicolson est inconditionnellement stable,
ce qui autorise des pas de temps larges devant le temps de diffusion
maille sans perte de precision majeure.
"""

import numpy as np
from scipy.linalg import solve_banded


class PastilleV1:
    """Solveur 1D cylindrique : symetrie automatique au centre,
    Dirichlet en surface, source volumique interne uniforme ou
    variable."""

    def __init__(self, alpha, k_th, R, N, dt,
                 T_surface, T_init=None, source=None):
        """
        alpha      : diffusivite thermique [m^2/s]
        k_th       : conductivite thermique [W/(m.K)]
        R, N, dt   : rayon [m], nombre de noeuds, pas de temps [s]
        T_surface  : temperature imposee en r=R [degC]
        T_init     : etat initial (defaut : pastille a T_surface)
        source     : puissance volumique dot_q [W/m3]. None / scalaire
                     / tableau (N,)
        """
        self.alpha = alpha
        self.k_th = k_th
        self.rho_cp = k_th / alpha  # W/(m3.K), pour convertir W/m3 -> K/s

        self.R = R
        self.N = N
        self.dt = dt
        self.dr = R / (N - 1)
        self.r = np.linspace(0.0, R, N)

        # Geometrie vertex-centered : aire des faces internes (cylindre,
        # par unite de longueur axiale) et volume de chaque cellule.
        dr = self.dr
        i = np.arange(N)
        r_face = (i[:-1] + 0.5) * dr
        self.Aface = 2.0 * np.pi * r_face

        self.V = np.empty(N)
        self.V[0] = np.pi * (0.5 * dr) ** 2          # disque plein central
        self.V[1:-1] = 2.0 * np.pi * self.r[1:-1] * dr
        r_face_last = self.r[-1] - 0.5 * dr
        self.V[-1] = np.pi * (self.r[-1] ** 2 - r_face_last ** 2)

        self.T_surface = T_surface

        if source is None:
            self.source = np.zeros(N)
        elif np.isscalar(source):
            self.source = np.full(N, float(source))
        else:
            self.source = np.array(source, dtype=float)
            if self.source.shape != (N,):
                raise ValueError("source doit etre un scalaire ou un tableau (N,)")

        self.T = np.full(N, T_surface) if T_init is None else np.array(T_init, float)
        self.T[-1] = T_surface

        self.t = 0.0
        self.historique = [self.T.copy()]
        self.temps = [0.0]

        # Conductances [W/K] entre noeuds voisins, constantes dans le temps
        # (k et la geometrie sont fixes) -> la matrice n'est construite qu'une fois.
        self.aE = k_th * self.Aface / dr

        self.ab = self._construire_matrice()

    def _construire_matrice(self):
        """Matrice tridiagonale (format banded, 3xN) du bilan Crank-Nicolson
        sur chaque cellule :

            (rho_cp*V_i/dt + 0.5*(aE_i+aW_i)) T_i^{n+1}
                - 0.5*aE_i * T_{i+1}^{n+1} - 0.5*aW_i * T_{i-1}^{n+1} = b_i
        """
        N, dt, rho_cp = self.N, self.dt, self.rho_cp
        V, aE_arr = self.V, self.aE

        ab = np.zeros((3, N))
        # ab[0] : sur-diagonale, ab[1] : diagonale, ab[2] : sous-diagonale

        for idx in range(1, N - 1):
            aE = aE_arr[idx]
            aW = aE_arr[idx - 1]
            diag = rho_cp * V[idx] / dt + 0.5 * (aE + aW)
            ab[1, idx] = diag
            ab[0, idx + 1] = -0.5 * aE
            ab[2, idx - 1] = -0.5 * aW

        # Noeud central : meme formule generale, aW nul (aire de face nulle)
        aE0 = aE_arr[0]
        ab[1, 0] = rho_cp * V[0] / dt + 0.5 * aE0
        ab[0, 1] = -0.5 * aE0

        # Noeud frontiere : Dirichlet
        ab[1, -1] = 1.0
        ab[2, -2] = 0.0

        return ab

    def step(self):
        """Avance d'un pas de temps (second membre recalcule, matrice reutilisee)."""
        N, dt, rho_cp = self.N, self.dt, self.rho_cp
        V, aE_arr, T = self.V, self.aE, self.T
        b = np.empty(N)

        for idx in range(1, N - 1):
            aE = aE_arr[idx]
            aW = aE_arr[idx - 1]
            flux_expl = aE * (T[idx + 1] - T[idx]) - aW * (T[idx] - T[idx - 1])
            b[idx] = (rho_cp * V[idx] / dt) * T[idx] + 0.5 * flux_expl + self.source[idx] * V[idx]

        aE0 = aE_arr[0]
        flux_expl0 = aE0 * (T[1] - T[0])
        b[0] = (rho_cp * V[0] / dt) * T[0] + 0.5 * flux_expl0 + self.source[0] * V[0]

        b[-1] = self.T_surface

        self.T = solve_banded((1, 1), self.ab, b)
        self.t += dt
        self.historique.append(self.T.copy())
        self.temps.append(self.t)
        return self.T

    def solve(self, n_steps):
        """Enchaine n_steps pas de temps."""
        for _ in range(n_steps):
            self.step()
        return self.T

    def get_historique(self):
        return np.array(self.historique), np.array(self.temps)

    def flux_sortant_frontiere(self):
        """Flux conductif [W/m axial] quittant le domaine par la derniere
        face interne. Sert a verifier la conservation d'energie : doit
        egaler la puissance generee dans le disque de rayon r_face_last
        en regime permanent."""
        aE_last = self.aE[-1]
        return aE_last * (self.T[-2] - self.T[-1])
